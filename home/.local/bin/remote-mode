#!/usr/bin/env bash
# remote-mode, prepares the laptop for remote access with RustDesk.
#
# Problem solved: hypridle turns the screen off after 7 minutes and suspends
# the machine after 20. With the screen off, capture turns black, and it is
# impossible to connect to a suspended machine. This script changes hypridle's
# config so neither happens, without giving up session locking.
#
#   remote-mode on      before leaving home
#   remote-mode off     upon returning
#   remote-mode status  to check its state

set -uo pipefail

HYPR_DIR="$HOME/.config/hypr"
CONF="$HYPR_DIR/hypridle.conf"
NORMAL="$HYPR_DIR/hypridle.d/normal.conf"
REMOTE="$HYPR_DIR/hypridle.d/remote.conf"

# There is intentionally no marker file: the state is derived from WHICH config
# is in hypridle.conf. A separate marker gets out of sync as soon as a step
# partially fails (for example: apply copied the config, restart failed, and
# the marker touch never ran -> remote config active but state says "off").
die() { echo "error: $*" >&2; exit 1; }

is_on() { cmp -s "$CONF" "$REMOTE"; }

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@" 2>/dev/null || true; }

on_battery() {
    local s
    for s in /sys/class/power_supply/A{C,DP}*/online; do
        [ -r "$s" ] && [ "$(cat "$s")" = "0" ] && return 0
    done
    return 1
}

apply() {  # $1 = config file to activate
    cp -f "$1" "$CONF" || die "could not write $CONF"
    # reset-failed clears systemd's startup counter. Without this, pressing the
    # button several times reaches the limit (5 starts in 10 s), systemd marks
    # the unit as failed, and hypridle is left DEAD: no session locking or idle
    # management. This actually happened on 2026-08-04.
    systemctl --user reset-failed hypridle.service 2>/dev/null
    systemctl --user restart hypridle.service 2>/dev/null
    sleep 1
    if ! systemctl --user is-active --quiet hypridle.service; then
        # Try again after clearing it once more in case restarts accumulated.
        systemctl --user reset-failed hypridle.service 2>/dev/null
        sleep 2
        systemctl --user restart hypridle.service 2>/dev/null
        sleep 1
    fi
    systemctl --user is-active --quiet hypridle.service \
        || die "hypridle did NOT start (config applied, but no idle management): systemctl --user status hypridle"
}

case "${1:-status}" in
on)
    [ -f "$REMOTE" ] || die "missing $REMOTE"
    apply "$REMOTE"
    # `dispatch` expects the native dispatcher and its argument; it does not
    # evaluate Lua.  Wake outputs so RustDesk has a composited frame at once.
    hyprctl dispatch dpms on >/dev/null 2>&1

    # RustDesk must be running for there to be something to connect to.
    if ! pgrep -x rustdesk >/dev/null 2>&1; then
        echo "RustDesk was not running, starting it..."
        setsid rustdesk --tray >/dev/null 2>&1 &
        sleep 5
    fi

    echo "REMOTE MODE ENABLED"
    echo "  · no suspend, screen stays on"
    echo "  · still locks after 6 min (unlock remotely)"
    echo "  · RustDesk: $(pgrep -x rustdesk >/dev/null && echo running || echo 'NOT RUNNING - check it')"
    echo "  · ID: $(timeout 15 rustdesk --get-id 2>/dev/null | tail -1)"
    if on_battery; then
        echo
        echo "  WARNING: running on BATTERY. Without suspend, it will drain and"
        echo "  you will lose access when it runs out. Keep it plugged in."
    fi
    notify "Remote mode ENABLED" "No suspend. RustDesk is accessible remotely."
    ;;
off)
    [ -f "$NORMAL" ] || die "missing $NORMAL"
    apply "$NORMAL"
    echo "Remote mode disabled: hypridle has returned to normal"
    echo "  (lock 6 min · screen 7 min · suspend 20 min)"
    notify "Remote mode disabled" "Normal power saving restored."
    ;;
is-on)
    # For the Quickshell button: prints on|off and always exits 0.
    is_on && echo on || echo off
    ;;
status)
    is_on && echo "remote mode: ENABLED" || echo "remote mode: disabled"
    echo "hypridle:  $(systemctl --user is-active hypridle.service 2>&1)"
    echo "rustdesk:  $(pgrep -x rustdesk >/dev/null && echo running || echo stopped)"
    echo "power: $(on_battery && echo BATTERY || echo plugged in)"
    echo "active config:"
    if cmp -s "$CONF" "$REMOTE"; then echo "  remote.conf (no suspend)"
    elif cmp -s "$CONF" "$NORMAL"; then echo "  normal.conf (suspends after 20 min)"
    else echo "  neither: $CONF was modified manually"; fi
    ;;
*)
    echo "usage: remote-mode {on|off|status|is-on}" >&2; exit 2 ;;
esac
