#!/usr/bin/env bash
# wall-triage, reviews wallpapers one by one and sets aside those you discard.
#
#   g / space  keep             d  discard
#   u          undo             q  quit (resumes where you left off)
#
# Nothing is deleted: discarded files move to ~/Pictures/wallpapers/.descartes/
# Delete them permanently only after reviewing that directory.

set -uo pipefail

DIR="${1:-$HOME/Pictures/wallpapers}"
TRASH="$DIR/.descartes"
STATE="$HOME/.cache/wall-triage.state"

[[ -d "$DIR" ]] || { echo "directory does not exist: $DIR"; exit 1; }

LOG="$HOME/.cache/wall-triage.log"
: > "$LOG"

# Rendering engine: kitty when running inside kitty, otherwise timg or chafa.
if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null; then
  ENGINE=kitty; ICAT=(kitten icat)
elif [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty >/dev/null; then
  ENGINE=kitty; ICAT=(kitty +kitten icat)
elif command -v timg >/dev/null; then
  ENGINE=timg
elif command -v chafa >/dev/null; then
  ENGINE=chafa
else
  echo "could not find kitty, timg, or chafa to render images."; exit 1
fi

# The timeout is for cases where the graphics protocol does not arrive (tmux
# without passthrough, ssh) and icat waits indefinitely for a terminal response.
#
# --foreground is REQUIRED: without it, timeout puts the command in its own
# process group, so it is no longer the tty foreground group. As soon as icat
# tries to read the graphics handshake response, it gets SIGTTIN and stops.
# Result: black screen and no image.
draw() {  # draw <file> <cols> <rows>
  case "$ENGINE" in
    kitty) timeout --foreground 5 "${ICAT[@]}" --clear --align center \
             --place "${2}x${3}@0x2" "$1" 2>>"$LOG" ;;
    timg)  timeout --foreground 5 timg -g "${2}x${3}" --center "$1" 2>>"$LOG" ;;
    chafa) timeout --foreground 5 chafa --size "${2}x${3}" --align center "$1" 2>>"$LOG" ;;
  esac
}
if [[ ! -t 0 ]]; then
  echo "This requires an interactive terminal."
  echo "Open kitty and run:  wall-triage"
  exit 1
fi

mkdir -p "$TRASH" "$(dirname "$STATE")"
touch "$STATE"

R=$'\e[0m'; B=$'\e[1m'; D=$'\e[2m'
GRN=$'\e[38;5;114m'; RED=$'\e[38;5;203m'; YEL=$'\e[38;5;179m'; CYA=$'\e[38;5;110m'

cleanup() { printf '\e[?25h\e[2J\e[H'; }
trap cleanup EXIT
printf '\e[?25l'   # hides the cursor

mapfile -t ALL < <(find "$DIR" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort)

FILES=()
for f in "${ALL[@]}"; do
  grep -Fxq "$(basename "$f")" "$STATE" || FILES+=("$f")
done

total=${#FILES[@]}
if (( total == 0 )); then
  cleanup
  echo "Nothing new to review in $DIR"
  echo "${D}(delete $STATE to review them all again)${R}"
  exit 0
fi

declare -a HIST_F HIST_A
kept=0; dropped=0; i=0

while (( i < total )); do
  f="${FILES[$i]}"
  if [[ ! -f "$f" ]]; then ((i++)); continue; fi

  cols=$(tput cols); rows=$(tput lines)
  imgrows=$(( rows - 5 )); (( imgrows < 5 )) && imgrows=5

  name=$(basename "$f")
  dims=$(identify -quiet -format '%wx%h' "${f}[0]" 2>/dev/null) || dims='?'
  size=$(du -h "$f" | cut -f1)

  printf '\e[2J\e[H'
  printf ' %s[%d/%d]%s  %s%s%s  %s%s · %s%s\n' \
    "$CYA" $((i+1)) "$total" "$R" "$B" "$name" "$R" "$D" "$dims" "$size" "$R"

  draw "$f" "$cols" "$imgrows"

  printf '\e[%d;1H' $(( rows - 1 ))
  printf ' %sg%s keep  %sd%s discard  %su%s undo  %sq%s quit   %s│  %d kept · %d discarded%s' \
    "$GRN" "$R" "$RED" "$R" "$YEL" "$R" "$D" "$R" "$D" "$kept" "$dropped" "$R"

  IFS= read -rsn1 key </dev/tty || break

  case "$key" in
    g|G|' ')
      echo "$name" >> "$STATE"
      HIST_F+=("$f"); HIST_A+=(keep); ((kept++)); ((i++))
      ;;
    d|D|x|X)
      mv -f "$f" "$TRASH/" 2>/dev/null
      HIST_F+=("$f"); HIST_A+=(drop); ((dropped++)); ((i++))
      ;;
    u|U)
      n=${#HIST_F[@]}
      (( n == 0 )) && continue
      last=$(( n - 1 ))
      pf="${HIST_F[$last]}"; pa="${HIST_A[$last]}"; pn=$(basename "$pf")
      if [[ "$pa" == drop ]]; then
        mv -f "$TRASH/$pn" "$pf" 2>/dev/null; (( dropped > 0 )) && ((dropped--))
      else
        grep -Fxv "$pn" "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
        (( kept > 0 )) && ((kept--))
      fi
      unset 'HIST_F[last]' 'HIST_A[last]'
      HIST_F=("${HIST_F[@]}"); HIST_A=("${HIST_A[@]}")
      (( i > 0 )) && ((i--))
      ;;
    q|Q)
      break
      ;;
  esac
done

cleanup
n_trash=$(find "$TRASH" -maxdepth 1 -type f | wc -l)
echo " ${B}Reviewed${R} $((kept + dropped)) of $total   ${GRN}$kept kept${R} · ${RED}$dropped discarded${R}"
if (( i < total )); then
  echo " ${D}$(( total - i )) remain unseen - run wall-triage again to resume where you left off.${R}"
fi
if (( n_trash > 0 )); then
  echo
  echo " ${B}$TRASH${R} contains $n_trash set-aside files:"
  find "$TRASH" -maxdepth 1 -type f -printf '   %f\n' | sort
  echo
  echo " ${D}They no longer appear in the picker. Delete them from that directory after reviewing them.${R}"
fi
