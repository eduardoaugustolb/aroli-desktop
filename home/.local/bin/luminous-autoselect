#!/usr/bin/env python3
"""Automatically responds to xdg-desktop-portal-luminous's screen selector.

Why it exists: luminous asks which monitor to share whenever an app requests a
capture. RustDesk does NOT implement persist_mode/restore_token, so there is no
way for it to "remember" the authorization: it would ask every time. When away
from home, no one can answer, and the connection dies.

With LUMIOUS_HEADLESS=1, luminous does not draw any dialog: it connects to this
socket and waits for a response. This process acts as the server and always
answers with monitor 0.

Protocol (from the project's stream_message/src/lib.rs):
  socket  $XDG_RUNTIME_DIR/luminus_selector.sock
  frame   native u32 length + JSON payload
  request {"type":"screen_share","monitors":[...]}
  response {"type":"success","index":0} | {"type":"cancel"} | {"type":"busy"}

WARNING (security): this lets any application that requests a screen capture
obtain it without prompting. This is the unavoidable cost of unattended access.
"""
import json
import os
import socket
import struct
import sys
import threading

SOCK = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "luminus_selector.sock"
)


def log(msg):
    print(msg, flush=True)


def read_msg(conn):
    head = b""
    while len(head) < 4:
        chunk = conn.recv(4 - len(head))
        if not chunk:
            return None
        head += chunk
    (length,) = struct.unpack("=I", head)          # native u32
    if length == 0 or length > 1 << 20:
        log(f"unreasonable length ({length}), discarding")
        return None
    body = b""
    while len(body) < length:
        chunk = conn.recv(length - len(body))
        if not chunk:
            return None
        body += chunk
    return body


def write_msg(conn, obj):
    payload = json.dumps(obj).encode()
    conn.sendall(struct.pack("=I", len(payload)) + payload)


def handle(conn):
    with conn:
        raw = read_msg(conn)
        if raw is None:
            return
        log(f"request: {raw.decode('utf-8', 'replace')}")
        try:
            req = json.loads(raw)
        except json.JSONDecodeError:
            log("  invalid JSON, responding with cancel")
            write_msg(conn, {"type": "cancel"})
            return

        monitors = req.get("monitors") or []
        log(f"  offered monitors: {monitors} -> choosing index 0")
        write_msg(conn, {"type": "success", "index": 0})


def main():
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)          # owner only
    srv.listen(8)
    log(f"listening on {SOCK}")

    try:
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except KeyboardInterrupt:
        pass
    finally:
        srv.close()
        if os.path.exists(SOCK):
            os.unlink(SOCK)


if __name__ == "__main__":
    sys.exit(main())
