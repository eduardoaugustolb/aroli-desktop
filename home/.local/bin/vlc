#!/usr/bin/env bash
# VLC with the wallpaper palette.
#
# It is the machine's only Qt5 application, so it needs this workaround. The
# desktop exports QT_QPA_PLATFORMTHEME=qt6ct (see environment.d), and Qt5
# cannot resolve that name: it looks for libqt6ct.so among ITS plugins, does
# not find it, and ends up without a platform theme, using the stock gray
# (#efefef) in the middle of a pywal desktop. The variable does not accept a
# list of alternatives - tested: it is read literally and does not fall back -
# so the only option is to override it for this process.
#
# Before qt6ct, the desktop used the gtk3 theme and the symptom was the same
# for a different reason: Qt5's gtk3 plugin provides dialogs and fonts, never
# colors. Qt5 has always required its own theme.
#
# ~/.config/hypr/scripts/qt-pywal.py writes the scheme whenever the wallpaper
# changes.
#
# If qt5ct is not installed, continue as before without breaking anything.
if [ -e /usr/lib/qt/plugins/platformthemes/libqt5ct.so ]; then
  export QT_QPA_PLATFORMTHEME=qt5ct
fi
exec /usr/bin/vlc "$@"
